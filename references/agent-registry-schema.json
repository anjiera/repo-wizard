{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentRegistrySchema",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "pillar": {
        "type": "string",
        "enum": ["QUALITY", "SECURITY", "ARCHITECTURE", "PERFORMANCE", "ORCHESTRATOR", "HELPER"]
      },
      "color": {
        "type": "string",
        "enum": ["WHITE", "YELLOW", "GREEN", "BLUE"]
      },
      "mockCapability": {
        "type": ["string", "null"]
      },
      "mockTool": {
        "type": ["string", "null"]
      },
      "command": {
        "type": ["string", "null"],
        "pattern": "^/.*$"
      },
      "reference": {
        "type": ["string", "null"]
      }
    },
    "required": ["title", "description", "pillar", "color", "mockCapability", "mockTool", "command", "reference"],
    "additionalProperties": false
  }
}
